# ================================
# Application Info
# ================================
SPRING_APPLICATION_NAME=member-management-system
SERVER_PORT=8088

# ================================
# Database Config (Local)
# ================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=member_management_db
DB_USERNAME=root
DB_PASSWORD=root

# ===== ADMIN DEFAULT CREDENTIALS =====
DEFAULT_ADMIN_EMAIL=admin@mms.com
DEFAULT_ADMIN_PASSWORD=admin123

# ================================
# Flyway
# ================================
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_LOCATIONS=classpath:db/migration

# ================================
# JPA Config
# ================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# ================================
# JWT Configuration
# ================================
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ================================
# Swagger API
# ================================
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
